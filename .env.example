# Copy to .env for local overrides (optional — defaults work with docker-compose)

SERVER_PORT=8080

# Redis (local Maven run assumes Redis on localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache TTLs (seconds)
CACHE_PRODUCTS_TTL=300
CACHE_CATEGORY_TTL=120

# Spring profile: leave empty for local; "docker" when running in compose
# SPRING_PROFILES_ACTIVE=docker
